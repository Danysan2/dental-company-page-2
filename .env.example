# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@host:5432/dental-page"

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-change-in-production"

# EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_PACIENTE=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_CLINICA=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Correo de notificaciones internas
NEXT_PUBLIC_CLINICA_EMAIL=clinica@example.com

# Google — Service Account + Sheets + Calendar
# GOOGLE_SERVICE_ACCOUNT_FILE debe ser el JSON completo de la cuenta de servicio (en una sola línea)
GOOGLE_SERVICE_ACCOUNT_FILE={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_SHEETS_ID=1q70LXQcyAmE8yMlgRxUnU65XaBWltxpdRycasRZUPlw
GOOGLE_CALENDAR_ID=dentalcompany.calendar@gmail.com
